<Window x:Class="Payesh.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="پایش | دفتر حقوقی هوشمند" Height="780" Width="1080" MinHeight="650" MinWidth="860" Background="#F3F6F9" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#102A43" CornerRadius="14" Padding="22" Margin="0,0,0,16"><DockPanel>
   <Border Width="58" Height="58" CornerRadius="12" Background="#168C8C" DockPanel.Dock="Right"><Grid><TextBlock Text="⚖" FontSize="29" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="T" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Grid></Border>
   <StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="پایش" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="دفتر حقوقی هوشمند | نسخه ویندوز" FontSize="14" Foreground="#D9EAF2" Margin="0,4,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="حفاظت محلی با رمزگذاری" Foreground="#D9EAF2" FontSize="12"/><TextBlock Text="همگام‌سازی رمزگذاری‌شده (آزمایشی)" Foreground="#8FE3D7" FontSize="12" Margin="0,5,0,0"/></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#DCE5EC" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="وضعیت همگام‌سازی" FontWeight="Bold" Foreground="#102A43"/><TextBlock x:Name="StatusText" Text="برای شروع، نشانی سرویس و اطلاعات اتصال را وارد کنید." TextWrapping="Wrap" Foreground="#526777" Margin="0,5,0,0"/></StackPanel>
   <Button Grid.Column="1" x:Name="SyncButton" Content="همگام‌سازی امن" Click="SyncButton_Click" Height="42" Background="#168C8C" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
  </Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,14,0" BorderBrush="#DCE5EC" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="اتصال و امنیت" FontSize="18" FontWeight="Bold" Foreground="#102A43" Margin="0,0,0,14"/>
    <TextBlock Text="نشانی سرویس همگام‌سازی (HTTPS)" Margin="0,0,0,5"/><TextBox x:Name="ServerUrlBox" Height="34" Padding="8" Text="https://"/>
    <TextBlock Text="شناسه کاربری" Margin="0,12,0,5"/><TextBox x:Name="UserIdBox" Height="34" Padding="8"/>
    <TextBlock Text="توکن دسترسی" Margin="0,12,0,5"/><PasswordBox x:Name="TokenBox" Height="34" Padding="8"/>
    <TextBlock Text="عبارت رمزگذاری شخصی (حداقل ۱۲ نویسه)" Margin="0,12,0,5"/><PasswordBox x:Name="PassphraseBox" Height="34" Padding="8"/>
    <Button Content="ذخیره امن روی همین رایانه" Click="SaveLocal_Click" Height="40" Margin="0,16,0,0" Background="#E8F2F7" Foreground="#102A43" BorderBrush="#CBD9E2"/>
    <TextBlock Text="عبارت رمزگذاری روی سرور ارسال نمی‌شود. آن را در جای امن نگه دارید؛ فراموشی آن می‌تواند بازیابی داده را ناممکن کند." TextWrapping="Wrap" FontSize="12" Foreground="#6B4E16" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></Border>
   <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#DCE5EC" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="داده‌های همگام‌شده دفتر" FontSize="18" FontWeight="Bold" Foreground="#102A43"/><TextBlock Text="خروجی ساختاریافته دفتر پایش از موبایل دریافت و رمزگشایی محلی می‌شود. ویرایش مستقیم برای جلوگیری از خرابی ساختار همگام‌سازی محدود است." Foreground="#526777" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <TextBox Grid.Row="1" x:Name="WorkspaceBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" FlowDirection="RightToLeft" VerticalContentAlignment="Top"/>
    <TextBlock Grid.Row="2" Text="نسخه اولیه ویندوز برای مشاهده و همگام‌سازی امن است؛ مدیریت کامل پرونده‌ها، ثنا و OCR هنوز در حال توسعه است." TextWrapping="Wrap" FontSize="12" Foreground="#6B4E16" Margin="0,12,0,0"/>
   </Grid></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="2,14,2,0"><TextBlock Text="پایش | اطلاعات محرمانه را در رایانه مشترک ذخیره نکنید." Foreground="#526777" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Left" Text="نسخه آزمایشی" Foreground="#9B5C13" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
